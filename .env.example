NODE_ENV=production
PORT=3000

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=20000
OPENAI_RETRY_ATTEMPTS=3

# Airtable
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Leads
AIRTABLE_TIMEOUT=10000
AIRTABLE_RETRY_ATTEMPTS=2

# WhatsApp (kies een van beide)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/...
WATI_API_URL=https://live-mt-server.wati.io
WATI_API_KEY=Bearer ...

# Security
WEBHOOK_SECRET=your_shared_secret_for_make_hmac
ALLOWED_ORIGIN=http://localhost:3000

# Monitoring
METRICS_ENABLED=true
LOG_LEVEL=info
